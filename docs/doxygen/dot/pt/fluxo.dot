// Fluxo de cifra/decifra da chave hibrida, com as chamadas verificadas no codigo.
// Emisor: src/zupt_crypto.c:1296-1317 e 1340-1359 (zupt_hybrid_encrypt_init_mem)
// Receptor: src/zupt_crypto.c:1404-1445 (zupt_hybrid_decrypt_init_mem e
//           zupt_hybrid_decrypt_init_legacy_mem, que escolhem entre
//           zupt_mlkem768_decaps() e zupt_legacy_mlkem768_decaps()).
// Envelope: src/zupt_cxx.c:351-398 (zupt_hybrid_encrypt) e 401-470 (decrypt_records).
digraph fluxo {
  rankdir=TB;
  nodesep=0.25;
  ranksep=0.45;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontsize=9, fillcolor="#ffffff"];
  edge [color="#555555", arrowsize=0.5, fontsize=8];

  subgraph cluster_em {
    label="emissor";
    style="rounded"; color="#6f9e6f"; fontsize=10;
    e0 [label="zupt_hybrid_encrypt_init_mem", fillcolor="#ddeedd"];
    e1 [label="zupt_mlkem768_encaps(pk_ml)\nsegredo ML-KEM + texto cifrado (1088)", fillcolor="#f7e6cf"];
    e2 [label="zupt_x25519_base / zupt_x25519\nsegredo X25519 efemero", fillcolor="#f7e6cf"];
    e3 [label="rejeita segredo X25519 todo-zero", shape=diamond, fillcolor="#f3d8d8"];
    e4 [label="hybrid_kdf\n64 bytes: enc_key + mac_key", fillcolor="#ddeedd"];
    e5 [label="zupt_mlock_keys\n(enc_key, mac_key)", fillcolor="#ddeedd"];
    e6 [label="escreve cabecalho de cifra\n(1 + 1088 + 32 + 16 = 1137 bytes)", fillcolor="#dce6f7"];
    e0 -> e1 -> e2 -> e3 -> e4 -> e5 -> e6;
  }

  subgraph cluster_env {
    label="envelope v2";
    style="rounded"; color="#6b8cae"; fontsize=10;
    v0 [label="zupt_encrypt_buffer por bloco\n(nonce 16 + cifrado n + MAC 32)", fillcolor="#dce6f7"];
    v1 [label="envelope_tag\nHMAC-SHA256 sobre cabecalho + registros", fillcolor="#dce6f7"];
    v0 -> v1;
  }

  subgraph cluster_rc {
    label="receptor";
    style="rounded"; color="#b06060"; fontsize=10;
    r0 [label="zupt_hybrid_decrypt_init_mem\nou ..._legacy_mem", fillcolor="#f3d8d8"];
    r1 [label="zupt_mlkem768_decaps\nou zupt_legacy_mlkem768_decaps", fillcolor="#f7e6cf"];
    r2 [label="zupt_x25519\nsegredo X25519", fillcolor="#f7e6cf"];
    r3 [label="hybrid_kdf\nmesmas 64 bytes", fillcolor="#f3d8d8"];
    r4 [label="confere a tag final\nANTES de ler comprimentos", fillcolor="#f3d8d8"];
    r5 [label="decrypt_records\nvalida cada n antes de usar", fillcolor="#f3d8d8"];
    r0 -> r1 -> r2 -> r3 -> r4 -> r5;
  }

  e6 -> v0 [label="registros", fontsize=8];
  v1 -> r4 [label="tag final", fontsize=8];
  e6 -> r1 [label="1088 + 32 + 16", fontsize=8];
}
