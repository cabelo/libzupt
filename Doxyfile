GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_CHI           = NO
BINARY_TOC             = NO
TOC_EXPAND             = NO
GENERATE_QHP           = NO
QHP_NAMESPACE          =
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
TOC_INCLUDE_HEADINGS   = 3

# LATEX (desabilitado conforme política: apenas HTML) ----------------------

GENERATE_LATEX         = NO
LATEX_OUTPUT           = latex

# OUTROS FORMATS (desativados) ---------------------------------------------

GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# GRÁFICOS (Graphviz opcional; `dot` presente no ambiente de referência) ---

